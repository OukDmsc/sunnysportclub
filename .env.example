# Copy to .env.local for local development. Never commit real values.
# Required by the API in production (Vercel) and locally (`vercel dev`):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only admin key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to sign 30-day session tokens.
AUTH_SECRET=

# CLI / database tooling (not used at runtime):
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Infobip password recovery. API key and base URL are shared by SMS and email.
INFOBIP_API_KEY=
# Infobip API base URL from your account, e.g. https://xxxxx.api.infobip.com
INFOBIP_BASE_URL=
# Approved Infobip SMS sender name or phone number:
INFOBIP_SENDER=
# Approved Infobip email sender address:
INFOBIP_EMAIL_SENDER=
