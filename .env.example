# Copy to .env.local for local development. Never commit real values.
# Required by the API in production (Vercel) and locally (`vercel dev`):
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only admin key. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to sign 30-day session tokens.
AUTH_SECRET=

# CLI / database tooling (not used at runtime):
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Reserved for password recovery by SMS (not implemented yet):
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=
